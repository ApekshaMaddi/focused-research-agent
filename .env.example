# UI configuration
UI_API_BASE_URL=http://localhost:8000
UI_REQUEST_TIMEOUT=120

# API configuration
API_TITLE="Focused Research Agent API"
API_VERSION=1.0.0
API_DEBUG=false

# LLM configuration
# Options: groq | ollama
LLM_PROVIDER=ollama
LLM_MODEL=gpt-oss:20b-cloud
LLM_API_KEY=your_key_here
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096

# Groq alternative (comment above 3 lines and uncomment below to switch)
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=your_groq_key_here

# Search configuration
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=your_key_here
SEARCH_DEPTH=basic
SEARCH_MAX_RESULTS=5

# Database configuration
DATABASE_URL=sqlite:///./research_agent.db